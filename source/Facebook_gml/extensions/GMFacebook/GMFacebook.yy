  "ioscodeinjection": "\u003CYYIosPlist\u003E\n    \u003Ckey\u003EFacebookAppID\u003C/key\u003E\n    \u003Cstring\u003E${YYEXTOPT_GMFacebook_appId}\u003C/string\u003E\n\n    \u003Ckey\u003EFacebookClientToken\u003C/key\u003E\n    \u003Cstring\u003E${YYEXTOPT_GMFacebook_clientToken}\u003C/string\u003E\n\n    \u003Ckey\u003EFacebookDisplayName\u003C/key\u003E\n    \u003Cstring\u003E${YYEXTOPT_GMFacebook_displayName}\u003C/string\u003E\n\u003C/YYIosPlist\u003E\n\n\u003CYYIosCFBundleURLSchemesArray\u003E\n    \u003Cstring\u003Efb${YYEXTOPT_GMFacebook_appId}\u003C/string\u003E\n\u003C/YYIosCFBundleURLSchemesArray\u003E\n\n\u003CYYIosLSApplicationQueriesSchemesArray\u003E\n    \u003Cstring\u003Efbapi\u003C/string\u003E\n    \u003Cstring\u003Efb-messenger-share-api\u003C/string\u003E\n\u003C/YYIosLSApplicationQueriesSchemesArray\u003E\n\n\u003CYYIosCocoaPods\u003E\npod \u0027FBSDKCoreKit\u0027, \u0027~\u003E 18.1\u0027\npod \u0027FBSDKShareKit\u0027, \u0027~\u003E 18.1\u0027\npod \u0027FBSDKLoginKit\u0027, \u0027~\u003E 18.1\u0027\n\u003C/YYIosCocoaPods\u003E\n\n\u003CYYIosBuildSettingsInjection\u003E\nCLANG_ENABLE_OBJC_WEAK = YES;\n\u003C/YYIosBuildSettingsInjection\u003E",
