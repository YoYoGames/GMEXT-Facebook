  "ioscodeinjection":"\r\n<YYIosPlist>\r\n\r\n<key>CFBundleURLTypes</key>\r\n<array>\r\n  <dict>\r\n  <key>CFBundleURLSchemes</key>\r\n  <array>\r\n    <string>fb${YYEXTOPT_GMFacebook_appId}</string>\r\n  </array>\r\n  </dict>\r\n</array>\r\n\r\n     <key>FacebookAppID</key>\r\n     <string>${YYEXTOPT_GMFacebook_appId}</string>\r\n     <key>FacebookClientToken</key>\r\n     <string>${YYEXTOPT_GMFacebook_clientToken}</string>\r\n     <key>FacebookDisplayName</key>\r\n     <string>${YYEXTOPT_GMFacebook_displayName}</string>\r\n\r\n\r\n    <key>LSApplicationQueriesSchemes</key>\r\n    <array>\r\n      <string>fbapi</string>\r\n      <string>fb-messenger-share-api</string>\r\n    </array>\r\n\r\n</YYIosPlist>\r\n\r\n<YYIosCFBundleURLSchemesArray>\r\n     <string>fb${YYEXTOPT_GMFacebook_appId}</string>\r\n</YYIosCFBundleURLSchemesArray>\r\n\r\n<YYIosCocoaPods>\r\npod 'FBSDKCoreKit', '~> 18.1'\r\npod 'FBSDKShareKit', '~> 18.1'\r\npod 'FBSDKLoginKit', '~> 18.1'\r\n</YYIosCocoaPods> \r\n\r\n<YYIosBuildSettingsInjection>\r\nCLANG_ENABLE_OBJC_WEAK = YES;\r\n</YYIosBuildSettingsInjection>\r\n\r\n",
